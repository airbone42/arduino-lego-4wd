// Template for the WiFi credentials.
// -> Copy this file to "arduino_secrets.h" (same folder) and fill in your
//    own WiFi name and password.
// The real "arduino_secrets.h" is excluded via .gitignore and never ends
// up in the repository.

#define SECRET_SSID "YOUR_WIFI_NAME"
#define SECRET_PASS "YOUR_WIFI_PASSWORD"

// Password for the over-the-air firmware upload (OTA). Pick anything you
// like, you just have to pass the same value when uploading. It only stops
// someone else on your home network from accidentally flashing the car.
#define SECRET_OTA_PASS "lego4wd"
